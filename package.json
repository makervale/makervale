{
  "name": "makervale",
  "version": "0.1.0",
  "description": "A small multiplayer 3D world with a built-in editor, running entirely in the browser.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && prettier --check src",
    "format": "prettier --write src",
    "check": "npm run typecheck && npm run lint && npm run test",
    "privacy": "node tools/privacy-md.mjs",
    "site": "npm run build && npm run privacy && rm -rf site && mkdir site && cp -r dist/index.html dist/avatars PRIVACY.md THIRD_PARTY_LICENSES.md LICENSE site/"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.21.5",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-x": "^4.3.1",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.8.0",
    "vitest": "^1.6.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@pixiv/three-vrm": "^3.4.5",
    "fflate": "^0.8.2",
    "three": "^0.160.0",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.7.8",
    "trystero": "^0.26.0"
  }
}
